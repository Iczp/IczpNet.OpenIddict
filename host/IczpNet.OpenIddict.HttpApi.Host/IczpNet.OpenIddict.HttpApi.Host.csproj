<Project Sdk="Microsoft.NET.Sdk.Web">

  <Import Project="..\..\common.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <RootNamespace>IczpNet.OpenIddict</RootNamespace>
    <PreserveCompilationReferences>true</PreserveCompilationReferences>
    <UserSecretsId>IczpNet.OpenIddict-c2d31439-b723-48e2-b061-5ebd7aeb6010</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="Serilog.Sinks.Async" Version="2.1.0" />
    <!--<PackageReference Include="IdentityModel" Version="7.0.0" />-->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.9" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.StackExchangeRedis" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.9">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.2.1" />
    <!-- 为什么建议删除？ 
     Volo.Abp.OpenIddict / Volo.Abp.AspNetCore.Authentication.JwtBearer 已经自动传递了所需的一切 Token 和 Jwt 依赖，
     显式写死版本容易在后续版本升级时再次遭遇这种版本锁定与降级冲突。 -->
    <!-- <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.2.1" /> -->
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.2.1" />

    <PackageReference Include="Volo.Abp.Autofac" Version="10.6.1" />
    <PackageReference Include="Volo.Abp.Caching.StackExchangeRedis" Version="10.6.1" />
    <PackageReference Include="Volo.Abp.AspNetCore.Mvc.UI.MultiTenancy" Version="10.6.1" />
    <PackageReference Include="Volo.Abp.EntityFrameworkCore.SqlServer" Version="10.6.1" />
    <PackageReference Include="Volo.Abp.AspNetCore.Serilog" Version="10.6.1" />
    <PackageReference Include="Volo.Abp.Swashbuckle" Version="10.6.1" />
    <PackageReference Include="Volo.Abp.PermissionManagement.EntityFrameworkCore" Version="10.6.1" />
    <PackageReference Include="Volo.Abp.SettingManagement.EntityFrameworkCore" Version="10.6.1" />
    <PackageReference Include="Volo.Abp.AuditLogging.EntityFrameworkCore" Version="10.6.1" />
    <PackageReference Include="Volo.Abp.TenantManagement.EntityFrameworkCore" Version="10.6.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\IczpNet.OpenIddict.HttpApi\IczpNet.OpenIddict.HttpApi.csproj" />
    <ProjectReference Include="..\..\src\IczpNet.OpenIddict.Application\IczpNet.OpenIddict.Application.csproj" />
    <ProjectReference Include="..\..\src\IczpNet.OpenIddict.EntityFrameworkCore\IczpNet.OpenIddict.EntityFrameworkCore.csproj" />
    <ProjectReference Include="..\IczpNet.OpenIddict.Host.Shared\IczpNet.OpenIddict.Host.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Logs\**" />
    <Content Remove="Logs\**" />
    <EmbeddedResource Remove="Logs\**" />
    <None Remove="Logs\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="ConfigureAwait.Fody" Version="3.3.2" />
    <PackageReference Update="Fody" Version="6.9.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
